# FOOCUS — environment template.
# Copy to .env.local and fill in. Never commit real values.


# ---------------------------------------------------------------------------
# NEXT_PUBLIC_PARTYKIT_HOST — Team Room (realtime presence) host.
# ---------------------------------------------------------------------------
# PartyKit is a separate service; Vercel does not run it. This var is the ONLY
# switch that turns multiplayer on.
#
#   unset  -> the app runs in Solo Session mode. No WebSocket is opened at all.
#             This is the correct, working default for a plain Vercel deploy.
#   set    -> the Team Room connects to that host.
#
# Local development:
#   `npm run party:dev` serves party/index.ts on port 1999. Nothing to set —
#   in development the client falls back to localhost:1999 automatically.
#
# Production:
#   1. npx partykit login
#   2. npm run party:deploy      (prints the deployed URL)
#   3. set this var in Vercel to the deployed HOST — no scheme, no trailing
#      slash — then redeploy (it is inlined at build time).
#
# NEXT_PUBLIC_PARTYKIT_HOST=foocus.<your-partykit-username>.partykit.dev


# ---------------------------------------------------------------------------
# NEXT_PUBLIC_ADMIN_SECRET — passphrase gating the /admin telemetry dashboard.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_* is inlined into the client bundle and is therefore PUBLIC —
# readable by anyone who views source. Treat this as a speed bump against
# casual access, not as a security boundary. The telemetry it reveals is
# read from the visitor's own localStorage and never leaves the device.
#
# If unset, app/admin/page.tsx falls back to a hardcoded default — so set this
# explicitly in Vercel before deploying.
#
# NEXT_PUBLIC_ADMIN_SECRET=change-me
